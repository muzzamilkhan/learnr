# Postgres. The placeholder below counts as no database, so the server boots
# without persistence on a fresh clone.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"
PORT=3001

# The origins the browser may call this API from, comma separated and exact - a
# browser refuses a wildcard origin once a request carries credentials, and the
# session cookie is the whole authorisation here. Defaults to the port the web
# app's dev server listens on, so a local pair needs no entry.
LEARNR_WEB_ORIGINS="http://localhost:3000"
