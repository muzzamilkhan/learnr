# Postgres (Neon via Vercel Marketplace). Run `vercel env pull` once the
# integration is provisioned, or paste the pooled connection string here.
#
# This is the one connection the app has: every read and write goes through
# `src/server/`, Auth.js included. Without a real one the app still runs and
# plays - the placeholder below counts as "no database" (`isDatabaseConfigured`),
# so copying this file as it stands is enough to get started.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# Auth.js. Generate the secret with: npx auth secret
AUTH_SECRET=""

# Google OAuth - https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Sentry. The DSN is public by design - it ships inside the browser bundle - so
# it is the same value twice, once for each side. Without it the SDK initialises
# and sends nothing, which is the wanted behaviour on a laptop.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""

# Build-time only, and a real secret unlike the DSN: it uploads source maps so a
# production stack trace names your code rather than a minified bundle. It lives
# in the deploy workflow and in Vercel, never here.
SENTRY_AUTH_TOKEN=""

# Neon CLI (`npx neonctl`), for creating and dropping database branches. The
# Neon project is Vercel-managed, so the browser login flow is not enough - the
# CLI needs an API key, made in the Neon console (reached from the resource in
# the Vercel dashboard). Nothing in the app reads this; it is a tool credential.
NEON_API_KEY=""
