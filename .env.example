# The API server. Everything that used to be a Prisma call goes here - this app
# reads and writes nothing directly except the Auth.js tables. Defaults to the
# port `npm run dev --workspace apps/api` listens on, so a local pair needs no
# entry at all; production points at the Fly app.
LEARNR_API_URL="http://localhost:3001"

# Postgres (Neon via Vercel Marketplace). Run `vercel env pull` once the
# integration is provisioned, or paste the pooled connection string here.
#
# `apps/api` owns the schema and the migrations. What this app still needs a
# connection for is Auth.js alone: `PrismaAdapter` wants a live client in-process
# and cannot speak REST. See `src/auth-db.ts`.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# Auth.js. Generate the secret with: npx auth secret
AUTH_SECRET=""

# Google OAuth - https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
