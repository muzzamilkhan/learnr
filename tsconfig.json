{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // `infra` is a separate npm project with its own tsconfig, its own module
  // resolution and its own dependencies, so it typechecks itself. Excluded
  // here mainly because `cdk synth` stages a verbatim copy of this repository
  // under `infra/cdk.out/asset.<hash>/`, which `**/*.ts` would otherwise sweep
  // back in - a copy with no generated Prisma client, so it fails loudly and
  // only ever after a synth.
  "exclude": ["node_modules", "infra"]
}
